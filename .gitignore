# Virtual environments
.venv/
venv/
env/
ENV/

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# User uploads and temporary files
uploads/
*.log

# Scratch directory (ignore arbitrary temporary scratch files, keep regression test scripts)
scratch/*
!scratch/check_viewports.py
!scratch/test_chrome_regression_checklist.py

# Sensitive environment files (allow template .env.example)
.env
.env.local
.env.*.local
!.env.example

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Internal developer prompt files
CodeCraft_Antigravity_Master_Prompt.md

