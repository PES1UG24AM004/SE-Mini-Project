# CodeCraft Platform — Environment Configuration Template
# Copy to .env for local customization if needed. The application runs with sensible defaults if no .env exists.

# Server Network Configuration (Default: localhost only for privacy & safety)
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Python Runtime Settings
PYTHONUNBUFFERED=1

# MLflow Experiment Tracking Configuration
# Enable or disable automated tracking (true / false)
MLFLOW_ENABLED=true

# Tracking server URI (default: local SQLite or local MLflow tracking server)
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Canonical experiment name for metabolic risk benchmarking
MLFLOW_EXPERIMENT_NAME=CodeCraft-Metabolic-Risk-Benchmark

# Optional authentication for secured or remote tracking servers (leave empty for local)
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

