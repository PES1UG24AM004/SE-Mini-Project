# CodeCraft Platform — Environment Configuration Template
# Copy to .env for local customization if needed. The application runs with sensible defaults if no .env exists.

# Server Network Configuration (Default: localhost only for privacy & safety)
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Python Runtime Settings
PYTHONUNBUFFERED=1
